# ═══════════════════════════════════════════════════════════
# Haber Kölesi - Ortam Değişkenleri
# ═══════════════════════════════════════════════════════════
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# cp .env.example .env

# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/havuz
DB_MIN_POOL=2
DB_MAX_POOL=10

# ── Gemini API (alternatif sağlayıcı; isteğe bağlı) ──────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_SCORE=8.0
GEMINI_MIN_INTERVAL_SECONDS=15
CANDIDATE_LIMIT_PER_CATEGORY=3

# ── OpenAI (varsayılan sağlayıcı) ───────────────────────────
# Anahtarı yalnızca yerel .env dosyasına ekleyin, ardından yeniden başlatın.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low

# ── Yönetim Paneli ─────────────────────────────────────────
ADMIN_PASSWORD=1234
SESSION_SECRET=replace_with_a_long_random_value
COOKIE_SECURE=false

# ── X (Twitter) Resmi API v2 (Pay-per-use) ────────────────
# Paylaşımı etkinleştirmek için true yapın
X_ENABLED=false
X_AUTO_PUBLISH=true
X_DAILY_LIMIT=8
X_BACKEND=official

# X Developer Portal -> Project/App -> "Keys and tokens" sekmesinden alınır
# DİKKAT: Access Token üretmeden önce App Permissions -> "Read and Write" seçilmelidir!
X_API_KEY=your_consumer_api_key
X_API_KEY_SECRET=your_consumer_api_key_secret
X_ACCESS_TOKEN=your_user_access_token
X_ACCESS_TOKEN_SECRET=your_user_access_token_secret

# ── Blog → X / Threads otomatik yayın ──────────────────────
# Genel anahtar. Paneldeki kalıcı anahtar da açık olmalıdır.
AUTO_PUBLISH=false
# /api ile bitmeli. Aynı Coolify ağında iç servis URL'si kullanılabilir.
DEVOSUIT_API_URL=https://YOUR_BACKEND_DOMAIN/api
DEVOSUIT_SITE_URL=https://devosuit.com
# Devosuit backend NEWS_PUBLISH_TOKEN ile aynı, en az 32 karakter rastgele anahtar.
DEVOSUIT_PUBLISH_TOKEN=
# X_ENABLED kanalı açar, X_AUTO_PUBLISH otomatik işlerde X'i seçer.
# Resmî Threads API: kullanıcı adı/şifre kullanılmaz.
THREADS_ENABLED=false
THREADS_USER_ID=
# Uzun ömürlü (60 günlük) token. Sistem yenilenen tokenı PostgreSQL'de saklar.
THREADS_ACCESS_TOKEN=

# ── Anti-Bot Gecikmeleri (saniye) ──────────────────────────
MIN_DELAY=2.0
MAX_DELAY=7.0

# ── Veri Dizini ────────────────────────────────────────────
DATA_DIR=./data
