# ═══════════════════════════════════════════════════════════
# Haber Kölesi - Ortam Değişkenleri
# ═══════════════════════════════════════════════════════════
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# cp .env.example .env

# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/havuz
DB_MIN_POOL=2
DB_MAX_POOL=10

# ── Gemini API ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_SCORE=8.0
GEMINI_MIN_INTERVAL_SECONDS=15
CANDIDATE_LIMIT_PER_CATEGORY=3

# ── Yönetim Paneli ─────────────────────────────────────────
ADMIN_PASSWORD=1234
SESSION_SECRET=replace_with_a_long_random_value
COOKIE_SECURE=false

# ── X (Twitter) Resmi API v2 (Pay-per-use) ────────────────
# Paylaşımı etkinleştirmek için true yapın
X_ENABLED=false
X_AUTO_PUBLISH=true
X_DAILY_LIMIT=8
X_BACKEND=official

# X Developer Portal -> Project/App -> "Keys and tokens" sekmesinden alınır
# DİKKAT: Access Token üretmeden önce App Permissions -> "Read and Write" seçilmelidir!
X_API_KEY=your_consumer_api_key
X_API_KEY_SECRET=your_consumer_api_key_secret
X_ACCESS_TOKEN=your_user_access_token
X_ACCESS_TOKEN_SECRET=your_user_access_token_secret

# ── Threads (Instagram) ───────────────────────────────────
THREADS_USERNAME=your_threads_username
THREADS_PASSWORD=your_threads_password

# ── Anti-Bot Gecikmeleri (saniye) ──────────────────────────
MIN_DELAY=2.0
MAX_DELAY=7.0

# ── Veri Dizini ────────────────────────────────────────────
DATA_DIR=./data
